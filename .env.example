# App server (default 8100 — avoids API:8000, React:3000, Pi-hole)
APP_HOST=0.0.0.0
APP_PORT=8100
APP_TZ=Europe/Madrid

# Which Trading212 environment to use: DEMO or LIVE
T212_ENV=DEMO

# Trading212 Demo keys (Settings → API on practice account)
T212_DEMO_API_KEY=your_demo_key
T212_DEMO_API_SECRET=your_demo_secret

# Trading212 Live keys (Settings → API on real account)
T212_LIVE_API_KEY=your_live_key
T212_LIVE_API_SECRET=your_live_secret

# Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# auto = try models until one works (recommended)
GEMINI_MODEL=auto
# Prefer Flash Lite (free ~500 RPD). Avoid relying on 2.5 Flash (~20 RPD).
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# AI picks tickers from Trading212's instrument list
STRATEGY=Long-term growth portfolio managed autonomously by AI
MAX_PICKS=12
# 60 min weekdays ≈ up to ~48-72 Gemini calls/day (3 per cycle) — fine on Flash Lite 500 RPD
AUTOPILOT_INTERVAL_MINUTES=60
INSTRUMENTS_CACHE_HOURS=24

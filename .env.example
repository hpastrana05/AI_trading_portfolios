# App server (in-process listen port; Docker keeps container on 8100)
APP_HOST=0.0.0.0
APP_PORT=8100
APP_TZ=Europe/Madrid

# Host ports when running Demo + Live together (docker compose / scripts/run-both.sh)
DEMO_PORT=8100
LIVE_PORT=8101

# Sidebar "Open DEMO/LIVE" reuses whatever hostname you typed in the browser
# (pilab.local at home, pilab over VPN, localhost, etc.) and only swaps the port.
# Optional absolute override if you use a reverse proxy with different paths/hosts:
# OTHER_ENV_URL=https://example.com/live

# Which Trading212 environment a single local process uses (ignored by compose services,
# which force DEMO / LIVE per container).
T212_ENV=DEMO

# Trading212 Demo keys (Settings → API on practice account)
T212_DEMO_API_KEY=your_demo_key
T212_DEMO_API_SECRET=your_demo_secret

# Trading212 Live keys (Settings → API on real account)
T212_LIVE_API_KEY=your_live_key
T212_LIVE_API_SECRET=your_live_secret

# Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# auto = try models until one works (recommended)
GEMINI_MODEL=auto
# Prefer Flash Lite (free ~500 RPD). Avoid relying on 2.5 Flash (~20 RPD).
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# AI picks tickers from Trading212's instrument list
STRATEGY=Long-term growth portfolio managed autonomously by AI
MAX_PICKS=12
# 60 min weekdays ≈ up to ~48-72 Gemini calls/day (3 per cycle) — fine on Flash Lite 500 RPD
# Default cycle interval for new environments (minutes). Can be changed in the Dashboard UI.
AUTOPILOT_INTERVAL_MINUTES=60
INSTRUMENTS_CACHE_HOURS=24

# Performance
# DEMO P&L is measured from this starting capital (Trading212 practice default).
DEMO_BASELINE=5000
# First calendar day of the DEMO portfolio (performance origin).
DEMO_START_DATE=2026-07-30
